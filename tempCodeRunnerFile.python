import pygame
import random

pygame.init()
while True:
    # Screen
    WIDTH, HEIGHT = 400, 600
    screen = pygame.display.set_mode((WIDTH, HEIGHT))
    pygame.display.set_caption("Mini Flappy Bird")

    clock = pygame.time.Clock()

    # Colors
    SKY = (135, 206, 235)
    GREEN = (0, 200, 0)
    YELLOW = (255, 255, 0)

    # Bird
    bird_x = 80 
    bird_y = HEIGHT // 2
    bird_vel = 0
    gravity = 0.5
    jump = -8

    # Pipes
    pipe_width = 60
    gap = 150
    pipes = []

    def create_pipe():
        height = random.randint(100, 400)
        return [WIDTH, height]

    pipes.append(create_pipe())

    score = 0
    font = pygame.font.SysFont(None, 40)

    running = True
    while running:
        clock.tick(60)

        # Events
        for event in pygame.event.get():
            if event.type == pygame.QUIT:
                running = False

            if event.type == pygame.KEYDOWN:
                if event.key == pygame.K_SPACE:
                    bird_vel = jump

        # Bird physics
        bird_vel += gravity
        bird_y += bird_vel

        # New pipes
        if pipes[-1][0] < 200:
            pipes.append(create_pipe())

        # Move pipes
        for pipe in pipes:
            pipe[0] -= 3

        # Remove old pipes
        if pipes[0][0] < -pipe_width:
            pipes.pop(0)
            score += 1

        bird_rect = pygame.Rect(bird_x, bird_y, 30, 30)

        # Draw
        screen.fill(SKY)

        pygame.draw.circle(screen, YELLOW, (bird_x, int(bird_y)), 15)

        # Pipes and collision
        for pipe in pipes:
            top_rect = pygame.Rect(pipe[0], 0, pipe_width, pipe[1])
            bottom_rect = pygame.Rect(
                pipe[0],
                pipe[1] + gap,
                pipe_width,
                HEIGHT - pipe[1] - gap
            )

            pygame.draw.rect(screen, GREEN, top_rect)
            pygame.draw.rect(screen, GREEN, bottom_rect)

            if bird_rect.colliderect(top_rect) or bird_rect.colliderect(bottom_rect):
                running = False

        # Screen collision
        if bird_y < 0 or bird_y > HEIGHT:
            running = False

        # Score
        score_text = font.render(f"Score: {score}", True, (0, 0, 0))
        screen.blit(score_text, (10, 10))

        pygame.display.update()
    pygame.quit()
    